# Пример настроек. Скопировать в .env и заполнить своими значениями.
# Файл .env в git не попадает (см. .gitignore).

# Ключ подписи cookie-сессии. ОБЯЗАТЕЛЕН в бою.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RC_SECRET_KEY=

# Файл с учётками операторов (создаётся скриптом scripts/create_operator.py)
RC_OPERATORS_FILE=data/operators.json

# Сетевые параметры веб-интерфейса
RC_BIND_HOST=0.0.0.0
RC_PORT=8080

# Обновление из Git remote: по кнопке в операторской панели.
# Ветка по умолчанию — текущая Git-ветка; задайте RC_UPDATE_BRANCH=main,
# если нужно следить за main. Грязная рабочая копия не обновляется.
RC_UPDATE_REMOTE=origin
RC_UPDATE_BRANCH=

# true, если страница отдаётся по HTTPS (тогда cookie помечается Secure)
RC_COOKIE_SECURE=false

# SameSite для cookie сессии: Lax (по умолчанию), Strict или None.
# None нужен, когда пульт открыт во встроенном cross-site предпросмотре (iframe) —
# в этом случае приложение автоматически включает и Secure.
# Для реальной точки доступа робота оставляйте Lax.
RC_COOKIE_SAMESITE=Lax

# Блокировка после неудачных попыток входа
RC_MAX_FAILED_ATTEMPTS=5
RC_LOCKOUT_SECONDS=300

# --- Учётка оператора (создаётся автоматически при установке) ---
# По умолчанию admin / 1234.
# ВАЖНО: эти две переменные действуют ТОЛЬКО при первом создании учётки
# (когда файла data/operators.json ещё нет). Смена пароля здесь НЕ меняет
# существующую учётку — вход продолжит отвергать новый пароль!
# Сменить пароль существующей учётки:
#   .venv/bin/python scripts/create_operator.py --username admin --min-length 4
RC_OPERATOR=admin
RC_OPERATOR_PASSWORD=1234

# На борту страница /devices сохраняет проверяемые подсказки и последние
# наблюдения в data/device_registry.json; файл не задаёт роли/разрешения.
# Необязательно: другой абсолютный путь. При смене пути перенесите файл вручную.
# RC_DEVICE_REGISTRY_FILE=/opt/zapret/data/device_registry.json

# --- Интерфейс робота RUS SLAM ---
# master — четыре Arduino Mega с fw22+ и CRC-защищёнными ролями FL/FR/RL/RR;
# для мастера полного нуля требуется fw23 на всех четырёх платах.
# USB-автопоиск и переподключения пока экспериментальны: см. предупреждение README.
RC_SLAM_SOURCE=master
# --- Ручное назначение портов (автопоиск отключён) ---
# Четыре порта колёсных плат. Порядок не важен: роль FL/FR/RL/RR каждая плата
# сообщает сама в защищённой телеметрии fw22+ (CRC). Пусто — колёс нет:
# USB-порты программа не перебирает. Удобнее задать на борту: /devices.
# Лучше /dev/serial/by-id/… — имя переживает переподключение.
RC_WHEEL_PORTS=
# Старые RC_WHEEL_*_PORT режим master игнорирует. Старый скрипт обслуживания
# может прочитать их только после --confirm-physical-roles; они не доказывают роль.
# UART-порты в отдельном режиме RC_SLAM_SOURCE=serial (не master).
# В master эти старые имена игнорируются для поиска колёс, лидара и BMS.
RC_SLAM_PORTS=
RC_SLAM_PORT=
# Журнал ошибки памяти/незавершённого полного нуля блокирует движение; не удалять вручную.
# RC_FULL_ZERO_PENDING=data/full-zero.pending
# Порт мастера открывает только бортовой экран (8090): один процесс на UART.
# Пульт (8080) берёт телеметрию с экрана по HTTP. Адрес по умолчанию — порт RC_KIOSK_PORT;
# переопределите, только если экран на другом адресе.
# RC_SLAM_PEER_URL=http://127.0.0.1:8090/api/kiosk_state
# PIN открытия кейса в киоске; также ячейки хранения/руления инженерного веб-пульта.
RC_SLAM_PIN=7232
RC_SLAM_LOCK_FILE=data/lock.json
# Сводка работы (вкладка «Сводка» на 8080): файл накопителя и фоновый снимок раз в секунду.
RC_STATS_FILE=data/stats.json
# 0 — не снимать телеметрию в фоне (сводка тогда не пополняется).
RC_STATS_SAMPLER=1
RC_SLAM_MAX_ATTEMPTS=5
RC_SLAM_LOCK_SEC=30

# --- Управление с клавиатуры (WASD) ---
# Потолок тяги режима WASD, % (1…100). Клавиатура не даёт плавной обратной
# связи по скорости, поэтому по умолчанию 30 %: ползунок браузера не может
# подняться выше, а бортовой сервер сам отклоняет команду больше предела.
RC_KEYBOARD_MAX_PERCENT=30

# --- Опциональная осторожная навигация по карте SLAM ---
# НЕ Nav2 и не сертифицированная защита: сначала вручную проверьте карту,
# локализацию, E-STOP и свободную площадку. Движение поддерживается только
# бортовым RC_SLAM_SOURCE=master. На шасси без разворота на месте путь
# ограничен крабовым/прямым ходом до ±28° от курса. Цель может быть в UNKNOWN,
# но движение идёт по подтверждённо свободному участку (кроме начальной слепой
# зоны, которую оператор лично проверяет); при отсутствии продолжения — STOP.
# Это не замена независимого физического E-STOP.
# По умолчанию тяга полностью выключена. Включать только после испытаний.
RC_NAV_ENABLE=0
# Обязательная измеренная скорость на один процент команды t (м/с на 1%).
# Не подбирайте значение на глаз: замерьте на безопасной площадке. Проценты
# t не равны числу прямого ползунка Servo: например t=4% → Servo.write(7).
# Помощник: ./scripts/measure_nav_speed.py --distance 2 --seconds 8 --percent 4 --save-env
# Пока поле пустое, выезд ЗАБЛОКИРОВАН («Нет калибровки скорости»).
RC_NAV_MPS_PER_PERCENT=
# Уставка скорости и жёсткий предел тяги; прошивка/исполнитель всё равно проверяют свои лимиты.
# Предел тяги поднят с 4 % до 30 %: на малых процентах шасси не трогалось вовсе.
# 30 % остаётся вдвое ниже предела прошивки и ползунка WASD (RC_KEYBOARD_MAX_PERCENT).
RC_NAV_SPEED_MPS=0.05
RC_NAV_MAX_PERCENT=30
# Абсолютный потолок уставки скорости — MAX_SPEED_MPS=1.0 м/с в navigation.py.
# Держите уставку ниже измеренной скорости на пределе тяги:
# RC_NAV_MAX_PERCENT × RC_NAV_MPS_PER_PERCENT (например 30 % × 0,0375 = 1,12 м/с).
# При уставке выше ~0,25 м/с исполнитель опрашивает скан чаще (до 10 Гц),
# чтобы за один тик робот проезжал не больше 5 см.

# Радиус габарита: половина диагонали 75×60 см уже 0.480 м. Планировщик
# использует более консервативный квадрат. Измерьте выступы и добавьте запас.
RC_NAV_FOOTPRINT_M=0.55
# Смещение датчика вперёд от центра корпуса, используется картой и защитой.
# Измерьте на своей сборке; после изменения перезапустите и сбросьте карту.
RC_LIDAR_OFFSET_M=0.28
# Разворот установленного лидара относительно переда робота; 180° = перед/зад наоборот.
# После изменения сбросьте карту и проверьте направления вручную, без движения.
RC_LIDAR_YAW_DEG=180
# Сколько раз за поездку разрешено перестроить маршрут в обход препятствия,
# которое лидар видит, но которого ещё нет на карте (0 — сразу остановиться).
# Клетки обхода живут только в этой поездке и в карту не пишутся.
RC_NAV_DETOUR_ATTEMPTS=3

# --- Лидар 360° (карта на основном экране и на бортовом экране) ---
# Откуда берётся скан:
#   auto   — ROS 2, если он есть в системе, а если драйвер не поднялся за
#            RC_LIDAR_ROS_GRACE_S секунд — USB-порт читает само приложение
#            (по умолчанию);
#   ros    — только ROS 2: драйвер пакета (hls_lfcd_lds_driver, rplidar_ros,
#            ldlidar_stl_ros2, turtlebot3_node) публикует sensor_msgs/LaserScan
#            в топик ниже, а приложение подписывается на него и USB-порт не открывает;
#   serial — только USB-порт читает само приложение (стенд без ROS 2, отладка).
# ROS 2-путь — рекомендуемый: порт занимает драйвер производителя, а не подбор
# портов внутри приложения. ROS 2, драйверы и ros2_ws докачиваются и
# компилируются САМИ при запуске ярлыком «Запустить робот»; вручную — так же:
#   ./scripts/ros2_setup.sh && ./scripts/ros2_lidar.sh
# (ход установки: ./scripts/ros2_setup.sh --status, журнал var/ros2_setup.log)
RC_LIDAR_SOURCE=auto
# Топик скана: сюда публикует драйвер ROS 2, отсюда читает приложение.
RC_LIDAR_ROS_TOPIC=/scan
# Сколько секунд в режиме auto доверять ROS 2, если скан из /scan не идёт.
# Драйвер поднимается несколько секунд; но «ROS 2 установлен, а драйвер не
# запустился» не должно оставлять оба экрана без лидара — после этого окна
# приложение возвращается к чтению USB-порта (занятый драйвером порт оно всё
# равно не откроет). Как только /scan оживает, хозяином снова становится ROS 2.
# 0 — читать USB-порт сразу, не дожидаясь ROS 2.
# RC_LIDAR_ROS_GRACE_S=20
# Топик состояния супервизора драйвера (пакет zapret_lidar, JSON): виден в
# GET /api/lidar → ros.supervisor и в панели «Лидар» обоих экранов.
# RC_LIDAR_ROS_STATUS_TOPIC=/zapret/lidar/status
# Префикс ROS 2, если он не в /opt/ros/<дистрибутив> (например распакован вручную).
# RC_ROS_PREFIX=/opt/ros/humble
# Автоустановка ROS 2 ярлыком и ros2_lidar.sh: 0 — не ставить и не компилировать
# самим (установщик пишет это при --no-ros2).
# RC_ROS_AUTO=1
# Какие драйверы лидаров ставить/компилировать (по умолчанию — этот набор;
# sllidar_ros2 — по запросу, turtlebot3_node из исходников — при модели opencr):
# RC_ROS_DRIVERS=hls_lfcd_lds_driver rplidar_ros ldlidar_stl_ros2 turtlebot3_node
# Сборка самого ROS 2 из исходников, где нет готовых пакетов (Debian, Raspberry
# Pi OS, не-LTS Ubuntu): auto | 0 (никогда) | 1 (всегда).
# RC_ROS_SOURCE_BUILD=auto
# Потоков компилятора для colcon (по умолчанию — по свободной памяти, ~1.5 ГБ на поток).
# RC_ROS_BUILD_JOBS=2
# Зеркало репозитория ROS 2 вместо http://packages.ros.org/ros2/ubuntu.
# RC_ROS_APT_MIRROR=
# Эти же настройки меняет кнопка «Лидар» в веб-пульте или «Настройки» на
# бортовом экране: они пишут сюда RC_LIDAR_*. Приложения подхватывают изменения,
# но уже работающий ROS-супервизор нужно перезапустить. Руками править тоже можно.
# Явно заданный одиночный RC_LIDAR_PORT не требует пассивного подтверждения
# потока. Для остальных портов в master остаётся проверка USB-discovery;
# блокировки и исключения портов других устройств сохраняются.
# Не используйте автопоиск на действующем роботе до устранения ограничений README.
RC_LIDAR_PORT=
# Скорость порта. Пусто — подбор: RPLIDAR A1/A2M8 — 115200, A2M7/A2M12/A3/S1 —
# 256000, C1 — 460800, LD06/LD19 и LDS-01/LDS-02 — 230400. У RPLIDAR A3 на
# USB-адаптере есть переключатель 115200/256000 — он должен совпадать со скоростью.
RC_LIDAR_BAUD=
# Модель лидара — она же протокол для USB-пути: auto | rplidar | ld06 | lds01.
# USB-путь: auto проверяет все (RPLIDAR опрашивается командой SCAN, LD06/LD19 и
# LDS-01 сыплют пакеты сами). lds01 — это лидар TurtleBot3 Burger (LDS-01, он же
# HLS-LFCD2): кадры 0xFA по 42 байта на 230400. Понимаются и синонимы: lds-01,
# hls-lfcd2, turtlebot3.
# ROS 2-путь: эта же настройка выбирает драйвер супервизора — auto подбирает
# пакет сам (проверяет кадры на порту), а rplidar/ld06/lds01/turtlebot3 запускают
# соответствующий (rplidar_ros, ldlidar_stl_ros2, hls_lfcd_lds_driver,
# turtlebot3_node — лидар через плату OpenCR).
RC_LIDAR_PROTOCOL=auto
# Включение мотора RPLIDAR через линии USB-переходника (MOTOCTL):
# auto — перебрать варианты, none — линии не трогать (у многих клонов мотор
# питается постоянно), либо жёстко: dtr-low | dtr-high | rts-low | rts-high.
# У адаптеров A1/A2 мотор включает DTR в низком уровне.
RC_LIDAR_MOTOR=auto
# Настройки перебора сохраняются для совместимости; в master действуют
# дополнительные ограничения владельца и allowlist USB.
# 0 — лидар читает только RC_LIDAR_PORT и не перебирает соседние USB-порты
# (автопоиск отключён). 1 — диагностический перебор всех портов.
RC_LIDAR_AUTOPROBE=0
# 1 — поднимать лидар сразу при старте приложения (скан появляется на экране в
# первые секунды); 0 — самому порт не открывать: скан берётся у второго процесса
# робота по HTTP (см. RC_LIDAR_PEER_URLS).
RC_LIDAR_AUTOSTART=1
# Сколько секунд источник данных шасси не занимает USB-порты своей проверкой,
# пока лидар ищет свой. Иначе на роботе с двумя адаптерами оба перебора
# сталкиваются, и лидар пишет «все порты заняты другой программой» про порты,
# которые держит это же приложение. Окно ограничено: лидара на роботе может не
# быть вовсе, и бесконечная уступка оставила бы экраны без телеметрии модулей.
# 0 — не уступать (модули проверяют порты всегда, лидар ждёт между их кругами).
RC_LIDAR_PRIORITY_S=20
# Откуда брать скан, если порт держит второй процесс робота (пульт 8080 или
# бортовой экран 8090). Собственный адрес приложения из списка исключается.
# RC_LIDAR_PEER_URLS=http://127.0.0.1:8090/api/lidar,http://127.0.0.1:8080/api/lidar
# Явные исключения USB (через запятую). В master эти порты не открывает и
# автопоиск колёс; не перечисляйте здесь колёса. Лидар их тоже не трогает.
# RC_LIDAR_EXCLUDE=/dev/ttyUSB5
#
# Все четыре настройки ниже (порт, протокол, скорость, мотор) заполняет сама
# проверка — она же пишет постоянный путь /dev/serial/by-id/… и не трогает
# остальные строки файла:
#   .venv/bin/python scripts/lidar_check.py --save-env
# Проверить ROS 2-путь (дистрибутив, rclpy, пакеты драйверов) и убедиться, что
# скан дошёл до обоих экранов:
#   .venv/bin/python scripts/lidar_check.py --ros
#   .venv/bin/python scripts/lidar_web_check.py
# Статус драйвера ROS 2 прямо на роботе:
#   ./scripts/ros2_lidar.sh --status

# --- Аккумулятор JBD BMS ---
# Вручную укажите один порт на бортовом экране «АКБ» → «Подключение BMS»
# или здесь (лучше /dev/serial/by-id/…). Автопоиск BMS отключён.
# Физически проверьте устройство: путь сам по себе не подтверждает его тип.
# См. ограничения USB и docs/battery.md.
RC_BMS_PORT=
# Порт Kinect (USB-топология, например usb:1-2) и USB-UART принтера.
# Оба назначаются вручную на /devices; пусто — драйвер не выбран.
RC_KINECT_PORT=
RC_PRINTER_PORT=
# Порт платы модуля датчиков (свет, замок отсека, карты с ролями, компас):
# отдельная Arduino Mega на своём USB. Задаётся вручную; пусто — экран покажет
# «не подключён», а запрет движения по открытому отсеку работать не будет
# (состояние концевика неизвестно — сервер не считает отсек закрытым).
# Прошивка — firmware/sensor_module, протокол fw3. Экран платы — /sensors на
# бортовом экране (лента светодиодов пока не подключена: габариты в прошивке
# выключены до SENSOR_STRIP_ENABLED=1).
RC_SENSOR_PORT=

# --- Чековый принтер через отдельный USB-UART ---
# Порт выбирается и физически подтверждается на странице АКБ (дополнительно
# после каждого перезапуска/переподключения); это не снимает блокировку движения
# при неизвестном UART. Модель, питание и кодировка требуют проверки на роботе.
# Настройки сохраняются в data/printer.json; при необходимости путь можно сменить.
# RC_PRINTER_CONFIG=data/printer.json

# --- Камеры бортового экрана: 4 × Logitech C930e (круговой обзор) ---
# Спереди по бокам — FL и FR, сзади по бокам — RL и RR. id: 0=FL, 1=RL, 2=FR, 3=RR.
# У каждой камеры СВОЙ видеопорт. Автопоиск отключён: пусто — камера не
# назначена и не открывается (никаких /dev/video0…3 по умолчанию).
# Назначается только на борту: /devices → «Камеры».
# При необходимости установите OpenCV отдельно: .venv/bin/pip install opencv-python-headless
# (его нет в офлайн vendor). После выбора порта подтвердите кадр на /devices.
# /dev/v4l/by-id/… может отсутствовать/совпадать, а by-path описывает гнездо.
# RC_CAMERA_FRONT / RC_CAMERA_REAR — старые имена для FL и RL, сохранены.
RC_CAMERA_FRONT=
RC_CAMERA_REAR=
RC_CAMERA_FRONT_RIGHT=
RC_CAMERA_REAR_RIGHT=
# Алиасы: RC_CAMERA_FL_PORT, RC_CAMERA_FR_PORT, RC_CAMERA_RL_PORT, RC_CAMERA_RR_PORT,
#         RC_CAMERA_FRONT_PORT, RC_CAMERA_REAR_PORT и т.п. — читаются, но не пишутся.

# --- Геометрия камер: ЗАПОЛНИТЕ ПОСЛЕ ЗАМЕРА НА РОБОТЕ ---
# Ось X — вперёд, Y — влево (как на карте лидара), начало координат — центр корпуса.
# yaw: 0 — вперёд, +90° — влево, 180° — назад. По эскизу: передняя пара ±25°
# (50° между лучами), задняя пара ±135° (90° между лучами). Это только шаблон:
# пока переменные пусты, /api/sensors/layout сообщает calibrated=false.
# RC_CAMERA_FL_X_M=0.30
# RC_CAMERA_FL_Y_M=0.25
# RC_CAMERA_FL_Z_M=0.28
# RC_CAMERA_FL_YAW_DEG=-25
# RC_CAMERA_FL_PITCH_DEG=0
# RC_CAMERA_FR_X_M=0.30
# RC_CAMERA_FR_Y_M=-0.25
# RC_CAMERA_FR_Z_M=0.28
# RC_CAMERA_FR_YAW_DEG=25
# RC_CAMERA_FR_PITCH_DEG=0
# RC_CAMERA_RL_X_M=-0.30
# RC_CAMERA_RL_Y_M=0.25
# RC_CAMERA_RL_Z_M=0.28
# RC_CAMERA_RL_YAW_DEG=-135
# RC_CAMERA_RL_PITCH_DEG=0
# RC_CAMERA_RR_X_M=-0.30
# RC_CAMERA_RR_Y_M=-0.25
# RC_CAMERA_RR_Z_M=0.28
# RC_CAMERA_RR_YAW_DEG=135
# RC_CAMERA_RR_PITCH_DEG=0

# --- Kinect 360 (глубина в общую карту) ---
# Драйвер: scripts/kinect_depth_publisher.py шлёт кадры в POST /api/kinect/depth.
# Монтаж: по центру спереди; оптику и фильтры тоже можно переопределить здесь.
# RC_KINECT_X_M=0.35
# RC_KINECT_Y_M=0.0
# RC_KINECT_Z_M=0.30
# RC_KINECT_YAW_DEG=0
# RC_KINECT_PITCH_DEG=0
# RC_KINECT_HFOV_DEG=57
# RC_KINECT_VFOV_DEG=43
# RC_KINECT_MIN_RANGE_M=0.45
# RC_KINECT_MAX_RANGE_M=4.0
# RC_KINECT_MIN_HEIGHT_M=0.12
# RC_KINECT_MAX_HEIGHT_M=1.60
# RC_KINECT_SCAN_COLUMNS=80
# RC_KINECT_MAX_AGE_S=1.5
#
# Публикатор глубины поднимается сам при ./scripts/start_robot.sh, но только
# если установлен драйвер Kinect (без него демо-кадр НЕ подсовывается).
# 0 — не запускать; служба systemd робот-kinect-depth настраивается отдельно.
RC_KINECT_PUBLISHER_AUTOSTART=1
#
# Те же замеры удобно вносить с бортового экрана: /map → «Калибровка геометрии»
# (сохраняет значения прямо в этот .env). Порты камер настраиваются кнопкой ⚙.

# --- Опциональный второй Kinect 360 сзади по центру ---
# В исходной схеме сзади были только две C930e, поэтому выключен по умолчанию.
# Если второй Kinect всё же установлен: включите флаг, задайте его замеры и
# запустите второй публикатор с --unit rear.
# RC_KINECT_REAR_ENABLE=0
# RC_KINECT_REAR_X_M=-0.35
# RC_KINECT_REAR_Y_M=0.0
# RC_KINECT_REAR_Z_M=0.30
# RC_KINECT_REAR_YAW_DEG=180
# RC_KINECT_REAR_PITCH_DEG=0
# RC_KINECT_REAR_HFOV_DEG=57
# RC_KINECT_REAR_VFOV_DEG=43
# RC_KINECT_REAR_MIN_RANGE_M=0.45
# RC_KINECT_REAR_MAX_RANGE_M=4.0
# RC_KINECT_REAR_MIN_HEIGHT_M=0.12
# RC_KINECT_REAR_MAX_HEIGHT_M=1.60
# RC_KINECT_REAR_SCAN_COLUMNS=80
# RC_KINECT_REAR_MAX_AGE_S=1.5

# --- Автономное обследование (сам едет и достраивает карту) ---
# ВЫКЛЮЧЕНО по умолчанию. Включайте только после проверки E-STOP и карты.
# Требует RC_NAV_ENABLE=1, свежего лидара и свежего кадра Kinect, а также
# подтверждения оператором осмотра ближней зоны перед пуском.
RC_EXPLORE_ENABLE=0
# RC_EXPLORE_MAX_STEPS=40
# RC_EXPLORE_MAX_DURATION_S=900
# RC_EXPLORE_POLL_S=0.5
# RC_EXPLORE_STEP_TIMEOUT_S=180
# RC_EXPLORE_MIN_GAIN_CELLS=12
# RC_EXPLORE_MAX_NO_GAIN=3
# RC_EXPLORE_MAX_FAILURES=3
# RC_EXPLORE_GOAL_AHEAD_M=0.8
# RC_EXPLORE_MIN_GOAL_M=0.5
# RC_EXPLORE_MAX_GOAL_M=6.0
# RC_EXPLORE_MIN_CLUSTER_CELLS=4
# RC_EXPLORE_MAX_CANDIDATES=6
# RC_EXPLORE_REQUIRE_DEPTH=1
# RC_EXPLORE_REQUIRE_BLIND_CHECK=1

# --- Бортовой экран робота (киоск) ---
# Порт экрана (пульт оператора занимает 8080).
RC_KIOSK_PORT=8090
# Открывать экран в браузере в киоск-режиме. Пусто/не задано — открывать,
# если есть графическая сессия (DISPLAY/WAYLAND_DISPLAY). 0 — только сервер.
RC_KIOSK_OPEN=
# Снова открывать экран, если браузер закрыли (1 — да, по умолчанию).
RC_KIOSK_WATCHDOG=1
# Какой браузер запускать (по умолчанию — первый найденный из chromium/chrome/firefox).
RC_KIOSK_BROWSER=
# Пороги температуры бортового компьютера для панели «Бортовой компьютер» и
# чипа на экране, °C. Выше «внимание» — предупреждение, выше «критично» —
# статус «критично». Если «критично» ≤ «внимание», берутся 75/85.
# RC_PC_TEMP_WARN_C=75
# RC_PC_TEMP_CRIT_C=85
# Сколько записей настоящего журнала держать в памяти для панели «Логи»
# на бортовом экране (GET /api/kiosk_logs). 20…5000, по умолчанию 400.
RC_KIOSK_LOG_LIMIT=400
# Отдельный профиль киоска. Пусто — ~/.cache/robot-kiosk-browser.
# Snap Firefox этот скрытый путь не читает и показывает
# «Your Firefox profile cannot be loaded»; запуск сам перенесёт профиль
# в ~/snap/firefox/common/robot-kiosk-browser. Свой путь сработает, только
# если он не скрытый и лежит в домашнем каталоге (или уже в ~/snap/<имя>/).
# RC_KIOSK_PROFILE_DIR=

# --- Автозапуск ---
# Переменных окружения здесь нет: автозапуск приложения (службы systemd,
# ярлык сеанса, автоподъём точки доступа) включается и выключается командами
#   ./scripts/autostart.sh status   # что стартует само (по умолчанию)
#   ./scripts/autostart.sh off      # выключить автозапуск целиком
#   ./scripts/autostart.sh on       # вернуть автозапуск
# По умолчанию приложение само не запускается: пульт и экран поднимаются
# вручную — ./scripts/start.sh и ./scripts/kiosk.sh.
