# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- Секреты и локальные данные: в git не кладём ---
.env
*.secret
data/
var/
*.log

# --- Обучение YOLO: веса и метки в Git, тяжёлые кадры/логи — нет ---
.cache/
runs/
models/vision/*-smoke.pt
models/vision/*-smoke.json
models/vision/*.onnx
datasets/yolo-stop/images/
datasets/yolo-stop/raw/
datasets/yolo-stop/labels/*.cache
datasets/yolo-stop/*.zip
datasets/yolo-stop/source-repo.zip
# Refined training variant: keep compact labels/provenance, not pixels/caches.
datasets/yolo-stop-refined/images/
datasets/yolo-stop-refined/raw/
datasets/yolo-stop-refined/**/*.cache
datasets/yolo-stop-refined-color/images/
datasets/yolo-stop-refined-color/raw/
datasets/yolo-stop-refined-color/**/*.cache
datasets/yolo-stop-robot/images/
datasets/yolo-stop-robot/raw/
datasets/yolo-stop-robot/**/*.cache
# Deliberate portable delivery; other temporary exports remain ignored.
!models/vision/yolo-stop-robot.onnx

# --- Состояние интерфейса RUS SLAM (PIN ячейки пульта, журнал) ---
slam_gui/state/
